# Project Caspian Agent Configuration

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot (Milestone 1)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_AUTHORIZED_USER_ID=your_telegram_user_id_here

# Caspian Git Repository Path (Milestone 2)
CASPIAN_REPO_PATH=/path/to/caspian/repo

# Database Configuration
DATABASE_PATH=caspian_agent.db

# Security & Execution Limits
MAX_TOOL_CALLS_PER_REQUEST=10
LOG_LEVEL=INFO
