# Project Caspian Agent Configuration

# OpenRouter API (Primary LLM) — e.g. Baidu ERNIE-5.5-Flash-Preview (free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Alternative Providers (Optional fallbacks)
# Hugging Face Router API
HF_TOKEN=your_hugging_face_token_here
HF_MODEL=Qwen/Qwen3-4B:featherless-ai
HF_API_URL=https://router.huggingface.co/v1/chat/completions

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_AUTHORIZED_USER_ID=your_numeric_telegram_user_id_here

# X (Twitter) API
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here
X_DRY_RUN_MODE=true

# Caspian Git Repository Path (Read-only monitoring)
CASPIAN_REPO_PATH=/absolute/path/to/Project_Caspian

# Database & Storage
DATABASE_PATH=data/caspian.db

# Security & Limits
MAX_TOOL_CALLS_PER_REQUEST=10
LOG_LEVEL=INFO
